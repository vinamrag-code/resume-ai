rules_version = '2';

// Each signed-in user can read and write only their own items: users/{uid}/items/{id}.
// Admins can also manage the AI model list. Everything else is denied. Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // An admin is a signed-in user with a document at admins/{their uid}. Create it once by hand in the
    // Firebase console (no code or rules edit needed); nobody can create or change it from the app.
    // Email/password accounts must have verified their address; Google accounts always are.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return verified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // The AI model allowlist and defaults. Anyone may read it (model names are not secret, and the server
    // reads it without a user token); only admins may change it.
    match /config/{doc} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isAdmin()
        && doc == 'models'
        && request.resource.data.keys().hasOnly(['groq', 'openrouter', 'inception', 'defaults', 'updatedAt'])
        && request.resource.data.keys().hasAll(['groq', 'openrouter', 'defaults', 'updatedAt'])
        && request.resource.data.groq is list && request.resource.data.groq.size() >= 1 && request.resource.data.groq.size() <= 20
        && request.resource.data.openrouter is list && request.resource.data.openrouter.size() >= 1 && request.resource.data.openrouter.size() <= 20
        && (!('inception' in request.resource.data) || (request.resource.data.inception is list && request.resource.data.inception.size() >= 1 && request.resource.data.inception.size() <= 20))
        && request.resource.data.defaults is map
        && request.resource.data.updatedAt is number;
    }

    match /users/{uid}/items/{id} {
      allow read, delete: if verified() && request.auth.uid == uid;

      allow create, update: if verified() && request.auth.uid == uid
        && id.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.keys().hasOnly(['kind', 'json', 'updatedAt', 'deleted'])
        && request.resource.data.keys().hasAll(['kind', 'json', 'updatedAt', 'deleted'])
        && request.resource.data.kind in ['resume', 'job', 'letter', 'chat', 'bank']
        && request.resource.data.json is string
        && request.resource.data.json.size() < 700000
        && request.resource.data.updatedAt is number
        && request.resource.data.deleted is bool;
    }
  }
}
