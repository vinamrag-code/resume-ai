rules_version = '2';

// Each signed-in user can read and write only their own items: users/{uid}/items/{id}.
// Everything else is denied. Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/items/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && id.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.keys().hasOnly(['kind', 'json', 'updatedAt', 'deleted'])
        && request.resource.data.keys().hasAll(['kind', 'json', 'updatedAt', 'deleted'])
        && request.resource.data.kind in ['resume', 'job', 'letter']
        && request.resource.data.json is string
        && request.resource.data.json.size() < 700000
        && request.resource.data.updatedAt is number
        && request.resource.data.deleted is bool;
    }
  }
}
