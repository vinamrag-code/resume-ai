# Server-side settings. Copy this file to .env. Read by the Node server / dev server only.
# The AI keys are secrets and are NEVER sent to the browser.

# --- AI providers (free keys) ---
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Firebase (Google sign-in + Firestore cloud sync) ---
# Firebase console -> Project settings -> General -> Your apps -> Web app config.
# These four values are public by design (every Firebase web app ships them); access is protected by
# sign-in and the Firestore security rules in firestore.rules. With all four set, AI features and
# cloud sync require signing in; manual editing never does. Leave empty to run with no sign-in.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# --- Optional tuning (defaults shown) ---
# RATE_LIMIT_PER_MINUTE=20          anonymous visitors (per IP) when sign-in is off
# RATE_LIMIT_PER_DAY=300
# USER_RATE_LIMIT_PER_MINUTE=30     signed-in users (per account)
# USER_RATE_LIMIT_PER_DAY=500
# GROQ_ALLOWED_MODELS=openai/gpt-oss-120b
# OPENROUTER_ALLOWED_MODELS=nvidia/nemotron-3-super-120b-a12b:free
# MAX_OUTPUT_TOKENS=4096
# TRUST_PROXY=1                     set to 1 behind a platform proxy (Render, Fly, Heroku)
# PORT=8787
# BASE_PATH=/                       URL prefix the app is served under, e.g. /resume-ai/ behind a reverse proxy (applied at build time)
