# Server-side settings. Copy this file to .env. These are read by the Node server / dev server only
# and are NEVER bundled into the browser build.

# --- AI providers (free keys) ---
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Google sign-in (optional locally, recommended when hosting) ---
# With both set, AI features and cloud sync require signing in; manual editing never does.
# Create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
# and add your site URL (and http://localhost:5173 for development) under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=
# Any random string of 32+ characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# --- Cloud sync storage ---
# Without DATABASE_URL, data is stored as files in DATA_DIR (needs a persistent disk when hosting).
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATA_DIR=data

# --- Optional tuning (defaults shown) ---
# RATE_LIMIT_PER_MINUTE=20          anonymous visitors (per IP) when sign-in is not configured
# RATE_LIMIT_PER_DAY=300
# USER_RATE_LIMIT_PER_MINUTE=30     signed-in users (per account)
# USER_RATE_LIMIT_PER_DAY=500
# SESSION_DAYS=7
# GROQ_ALLOWED_MODELS=openai/gpt-oss-120b
# OPENROUTER_ALLOWED_MODELS=nvidia/nemotron-3-super-120b-a12b:free
# MAX_OUTPUT_TOKENS=4096
# TRUST_PROXY=1                     set to 1 behind a platform proxy (Render, Fly, Heroku)
# PORT=8787
