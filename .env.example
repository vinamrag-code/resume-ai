# Copy this file to .env, add a key, and restart `npm run dev`.
# Then pick the provider in Settings. Only needed for the cloud providers; Ollama needs no key.
# WARNING: VITE_* values are bundled into the page. Use only on your own computer and
# never deploy a build made with real keys.
VITE_OPENROUTER_API_KEY=
VITE_GROQ_API_KEY=
