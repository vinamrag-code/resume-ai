# Copy this file to .env, add your keys, and restart `npm run dev`.
# Auto mode (default): Groq answers first (fastest); OpenRouter is the fallback and the independent
# fact-checker. One key is enough to start; both is best. Both have free tiers.
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
# WARNING: VITE_* values are bundled into the page. Use only on your own computer and
# never deploy a build made with real keys.
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
