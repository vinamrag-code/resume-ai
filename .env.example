# Server-side settings. Copy this file to .env. These are read by the Node server / dev server only
# and are NEVER bundled into the browser build.
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional tuning (defaults shown)
# RATE_LIMIT_PER_MINUTE=20     requests per visitor per minute
# RATE_LIMIT_PER_DAY=300       requests per visitor per day
# GROQ_ALLOWED_MODELS=openai/gpt-oss-120b
# OPENROUTER_ALLOWED_MODELS=nvidia/nemotron-3-super-120b-a12b:free
# MAX_OUTPUT_TOKENS=4096
# TRUST_PROXY=1                set to 1 behind a platform proxy (Render, Fly, Heroku) so limits are per visitor
# PORT=8787
